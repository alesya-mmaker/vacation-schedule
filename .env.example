# Скопируйте этот файл в .env.local и вставьте значения из Supabase:
# Project Settings → API → Project URL и anon public key.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Необязательно: публичный адрес приложения для ссылок в сообщениях сотрудникам.
# Если не задан, берётся адрес, с которого работает HR.
# VITE_PUBLIC_URL=https://vacation-schedule-nu.vercel.app
